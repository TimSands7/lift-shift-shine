---
// Inline SVG icons keep the page JS-free and crisp at any size.
const services = [
	{
		title: 'House Cleaning',
		copy: 'Recurring or one-time housekeeping — kitchens, bathrooms, floors and living spaces, cleaned to a standard, not a rush.',
		icon: 'M4 11l8-6 8 6M6 10v9h12v-9M10 19v-5h4v5',
	},
	{
		title: 'Deep & Steam Sanitation',
		copy: 'A heavier clean for appliances, grout and buildup — steam sanitized to actually lift the grime, not just mask it.',
		icon: 'M6 3v3M10 3v3M14 3v3M5 8h14l-1.5 11.5A2 2 0 0 1 15.5 21h-7a2 2 0 0 1-2-1.5L5 8z',
	},
	{
		title: 'Move In / Move Out',
		copy: 'A full top-to-bottom clean before keys change hands, so the next chapter starts on a spotless floor.',
		icon: 'M3 13l2-5a2 2 0 0 1 1.9-1.3h10.2A2 2 0 0 1 19 8l2 5m-18 0v5h2v-2h12v2h2v-5m-18 0h18M7 16h.01M17 16h.01',
	},
	{
		title: 'Power Washing',
		copy: 'Driveways, siding, patios and walkways — blasted back to like-new without damaging the surface underneath.',
		icon: 'M4 13h9a4 4 0 1 0-3-6.6M4 13l3 7M4 13l-1 7M13 20l3-7',
	},
	{
		title: 'Window Cleaning',
		copy: 'Interior and exterior glass, streak-free — because a clean house isn’t clean if you can’t see out of it.',
		icon: 'M4 4h16v16H4zM12 4v16M4 12h16',
	},
	{
		title: 'Post-Construction Cleanup',
		copy: 'Dust, debris and residue cleared from every surface so a freshly built or renovated space is actually move-in ready.',
		icon: 'M14 3l7 7-9 9-7-7zM7 12l-4 4 5 5 4-4M14.5 5.5l4 4',
	},
];
---

<section id="services" class="bg-ink py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-10">
		<div class="max-w-3xl">
			<p class="kicker kicker-rule mb-6">Residential</p>
			<h2 class="font-display text-4xl uppercase leading-tight tracking-tight text-bone lg:text-6xl">
				Every corner of the home, handled.
			</h2>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-ash">
				One crew, six services — book what you need, when you need it, from a
				quick refresh to a full deep clean.
			</p>
		</div>

		<div class="mt-16 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
			{services.map((service) => (
				<div class="group bg-carbon p-9 transition-colors duration-300 hover:bg-steel">
					<span class="flex h-12 w-12 items-center justify-center border border-line text-red-bright transition-colors group-hover:border-red">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter">
							<path d={service.icon} />
						</svg>
					</span>
					<h3 class="mt-7 font-display text-xl uppercase tracking-wide text-bone">
						{service.title}
					</h3>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-ash">{service.copy}</p>
				</div>
			))}
		</div>
	</div>
</section>
